# Example environment configuration for the Price Tracker.
# Copy this file to .env and fill in your own values before running the app.
# No secrets should be committed; this file only documents available variables.

# ---------------------------------------------------------------------------
# HTTP client settings (all optional)
# ---------------------------------------------------------------------------

# Request timeout in seconds. Defaults to 30 if not set.
# HTTP_TIMEOUT=30

# Number of retries for failed HTTP requests. Defaults to 3 if not set.
# HTTP_RETRIES=3

# User-Agent header sent with every HTTP request. Defaults to a desktop
# browser string to reduce bot-blocking.
# HTTP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36

# Additional HTTP headers as a JSON object, e.g. {"Accept-Language": "en-AU"}.
# HTTP_HEADERS={}

# ---------------------------------------------------------------------------
# Email notifier settings
# ---------------------------------------------------------------------------

# SMTP server hostname (required for email notifications).
# Example: smtp.gmail.com, smtp.office365.com, email-smtp.ap-southeast-2.amazonaws.com
SMTP_HOST=

# SMTP server port. Defaults to 587.
# Common values: 25 (unencrypted), 587 (STARTTLS), 465 (SSL).
# SMTP_PORT=587

# SMTP transport security. Defaults to STARTTLS.
# Allowed values: SSL, STARTTLS, NONE.
# SSL uses SMTP-over-SSL (typical for port 465).
# STARTTLS upgrades a plain connection to TLS (typical for port 587).
# NONE sends email without encryption (not recommended for production).
# SMTP_SECURITY=STARTTLS

# SMTP authentication username (required when the server requires auth).
# For services like Gmail this is usually your full email address.
SMTP_USERNAME=

# SMTP authentication password or app-specific token (required when the server requires auth).
# Use an app password or API key instead of your account password when possible.
SMTP_PASSWORD=

# From email address used in outgoing alerts (required).
SMTP_FROM=

# Comma-separated list of recipient email addresses for price alerts (required).
# Example: alerts@example.com, admin@example.com
SMTP_TO=

# ---------------------------------------------------------------------------
# Application settings (optional)
# ---------------------------------------------------------------------------

# Logging level. Defaults to INFO.
# Allowed values: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Supabase / PostgreSQL storage (optional, enables persistent storage)
# ---------------------------------------------------------------------------

# Full connection string for the Supabase Supavisor transaction-mode pooler.
# The app falls back to the in-memory product catalog when this is empty.
# Example:
#   postgres://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# SUPABASE_DATABASE_URL=
